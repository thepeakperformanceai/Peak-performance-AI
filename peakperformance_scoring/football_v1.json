    "mann2015": {"authors": "Mann JB, Ivey PJ, Brechue WF, Mayhew JL", "year": 2015, "title": "Validity and reliability of hand and electronic timing for 40-yd sprint in college football players", "journal": "Journal of Strength and Conditioning Research", "volume": "29", "issue": "6", "pages": "1509-1514", "url": "https://pubmed.ncbi.nlm.nih.gov/25785707/", "note": "81 NCAA Division I players; experienced hand timers were 0.22 s faster than electronic timing."}
