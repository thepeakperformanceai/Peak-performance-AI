# Own database — SEPARATE from the main app
MONGODB_URI=mongodb+srv://user:pass@cluster/peakdashboard

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# How this backend reaches the main app's report engine
MAIN_BACKEND_URL=https://backend.peakaiperformance.com/api
SERVICE_API_KEY=must-match-SERVICE_API_KEY-on-the-main-backend

# Where the dashboard frontend is served (CORS)
FRONTEND_URL=http://localhost:5173

PORT=5100
